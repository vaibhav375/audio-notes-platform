# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, or any Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vercel Blob read/write token. Injected automatically on Vercel; needed
# locally to test uploads. Vercel dashboard -> Storage -> Blob -> Tokens.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Gnani speech-to-text. Sign up at https://gnani.ai/speech-to-text-api
GNANI_API_KEY="your-gnani-api-key"
GNANI_BASE_URL="https://api.vachana.ai"
GNANI_MODEL="gnani-prisma-v2.5"

# Transcription path: auto | batch | sync
#   auto  - try the batch job API, fall back to the synchronous endpoint
#   batch - batch only
#   sync  - transcribe slice by slice through the synchronous endpoint
TRANSCRIBE_MODE="auto"

# Shared secret guarding the job-completion webhook. Any long random string.
# Leave unset to disable webhooks and rely on polling alone.
GNANI_WEBHOOK_SECRET="generate-a-long-random-string"

# Public origin used to build the webhook callback URL. Set automatically on
# Vercel; set manually when running behind a tunnel.
# APP_ORIGIN="https://your-deployment.vercel.app"

# Summarisation. Any OpenAI-compatible /chat/completions endpoint.
#   Groq:   https://api.groq.com/openai/v1        model: qwen/qwen3.8-27b
#   Ollama: http://localhost:11434/v1             model: qwen2.5:7b   (key: "ollama")
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your-llm-api-key"
LLM_MODEL="qwen/qwen3.8-27b"

# Shown on the /architecture page.
NEXT_PUBLIC_REPO_URL="https://github.com/vaibhav375/audio-notes-platform"
